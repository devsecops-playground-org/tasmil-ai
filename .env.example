# Copy to .env and fill in. Never commit the result.
APP_ENV=development
LOG_LEVEL=info

# Sibling services on the shared Tasmil VM network.
MCP_URL=http://mcp:3333
BACKEND_URL=http://backend:3000

# At least one model credential is required in production.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

MAX_STEPS=8
